[@@@warning "-unused-rec-flag"]

let strf fmt = Format.asprintf fmt

open Bin_type

type abs = Off.abs Off.t
type rel = Off.rel Off.t

type wmemo = Wm : ('a Witness.t * ('a -> S.t -> abs -> pos -> unit)) -> wmemo
[@@unboxed]

let rec wmemo_find : type a.
    a Witness.t -> wmemo list -> (a -> S.t -> abs -> pos -> unit) option =
 fun w -> function
  | [] -> None
  | Wm (w', fn) :: rest ->
      begin match Witness.eq w' w with
      | Some Witness.Refl -> Some fn
      | None -> wmemo_find w rest
      end

[@@@ocamlformat "disable"]

(* XXX(dinosaure): It's rather ugly, but it's necessary for performance. We need
   to be able to generate a function that allows writing, and this function must
   not contain any pattern matching (particularly regarding endianness). We need
   to move the pattern matching out of the write operation (and find it, in
   particular, in the [static_primary_writer_for] function).

   The trick [let _ = (); fun _ ->] is important here to ensure that the
   function has an arity of 3 when it is specialised. *)

let w_char delta get = (); fun v buf off ->
  S.unsafe_set buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ui8 delta get = (); fun v buf off ->
  S.unsafe_set_uint8 buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i8 delta get = (); fun v buf off ->
  S.unsafe_set_int8 buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ui16_le delta get = (); fun v buf off ->
  S.unsafe_set_uint16_le buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ui16_be delta get = (); fun v buf off ->
  S.unsafe_set_uint16_be buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ui16_ne delta get = (); fun v buf off ->
  S.unsafe_set_uint16_ne buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i16_le delta get = (); fun v buf off ->
  S.unsafe_set_int16_le buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i16_be delta get = (); fun v buf off ->
  S.unsafe_set_int16_be buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i16_ne delta get = (); fun v buf off ->
  S.unsafe_set_int16_ne buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i32_le delta get = (); fun v buf off ->
  S.unsafe_set_int32_le buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i32_be delta get = (); fun v buf off ->
  S.unsafe_set_int32_be buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i32_ne delta get = (); fun v buf off ->
  S.unsafe_set_int32_ne buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i64_le delta get = (); fun v buf off ->
  S.unsafe_set_int64_le buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i64_be delta get = (); fun v buf off ->
  S.unsafe_set_int64_be buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i64_ne delta get = (); fun v buf off ->
  S.unsafe_set_int64_ne buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ignore3 _ _ _ = ()

(* XXX(dinosaure): the same but for an arity of 4. *)

let w_ignore4 _ _ _ _ = ()

let[@inline always] w_1 set = (); fun v buf limit pos ->
  let offset = !pos in
  Bin_error.need_bytes ~limit ~offset ~need:Len.one;
  (pos := Off.(offset +> Len.one));
  set buf (offset :> int) v

let[@inline always] w_2 set = (); fun v buf limit pos ->
  let _2 = Len.unsafe 2 in
  let offset = !pos in
  Bin_error.need_bytes ~limit ~offset ~need:_2;
  (pos := Off.(offset +> _2));
  set buf (offset :> int) v

let[@inline always] w_4 set = (); fun v buf limit pos ->
  let _4 = Len.unsafe 4 in
  let offset = !pos in
  Bin_error.need_bytes ~limit ~offset ~need:_4;
  (pos := Off.(offset +> _4));
  set buf (offset :> int) v

let[@inline always] w_8 set = (); fun v buf limit pos ->
  let _8 = Len.unsafe 8 in
  let offset = !pos in
  Bin_error.need_bytes ~limit ~offset ~need:_8;
  (pos := Off.(offset +> _8));
  set buf (offset :> int) v

(* Thanks, god! *)
[@@@ocamlformat "enable"]

let write_varint value buf limit pos =
  if value < 0 then
    Bin_error.out_of_range ~offset:!pos ~kind:"varint"
      ~value:(string_of_int value);
  let num = ref (value lsr 7) in
  let cmd = ref (value land 0x7f) in
  cmd := if !num != 0 then !cmd lor 0x80 else !cmd;
  Bin_error.need_bytes ~limit ~offset:!pos ~need:Len.one;
  S.unsafe_set_uint8 buf (!pos :> int) !cmd;
  (pos := Off.(!pos +> Len.one));
  while !num != 0 do
    cmd := !num land 0x7f;
    num := !num lsr 7;
    cmd := if !num != 0 then !cmd lor 0x80 else !cmd;
    Bin_error.need_bytes ~limit ~offset:!pos ~need:Len.one;
    S.unsafe_set_uint8 buf (!pos :> int) !cmd;
    pos := Off.(!pos +> Len.one)
  done

type 'a fwrite = 'a -> S.t -> int -> int -> pos -> unit
type 'a swrite = 'a -> S.t -> abs -> unit

let bits_cells : type a. a bits -> (a -> int) array =
 fun b ->
  let layout = bits_layout b in
  let idx = ref 0 in
  let rec build : type x y. (x, y) bit_fields -> (x -> int) list = function
    | BF0 -> []
    | BF1 (field, rest) ->
        let shift, mask = layout.(!idx) in
        let name = field.bfname and width = field.bfwidth in
        let this : x -> int =
          match field.bfkind with
          | Bbool -> fun v -> if field.bfget v then 1 lsl shift else 0
          | Bint ->
              fun v ->
                let x = field.bfget v in
                if x land mask <> x then
                  Bin_error.out_of_range ~offset:Off.zero
                    ~kind:(strf "%d-bit field %s" width name)
                    ~value:(string_of_int x);
                x lsl shift
        in
        this :: build rest
  in
  let (BFields (fs, _)) = b.bfields in
  Array.of_list (build fs)

let bits_writer_at : type a. rel -> a bits -> a swrite =
 fun delta b ->
  let cells = bits_cells b in
  let word : a -> int =
    match Array.length cells with
    | 0 -> fun _ -> 0
    | 1 ->
        let c0 = cells.(0) in
        fun v -> c0 v
    | 2 ->
        let c0 = cells.(0) in
        let c1 = cells.(1) in
        fun v -> c0 v lor c1 v
    | 3 ->
        let c0 = cells.(0) in
        let c1 = cells.(1) in
        let c2 = cells.(2) in
        fun v -> c0 v lor c1 v lor c2 v
    | 4 ->
        let c0 = cells.(0) in
        let c1 = cells.(1) in
        let c2 = cells.(2) in
        let c3 = cells.(3) in
        fun v -> c0 v lor c1 v lor c2 v lor c3 v
    | n ->
        fun v ->
          let w = ref 0 in
          for idx = 0 to n - 1 do
            w := !w lor (Array.unsafe_get cells idx) v
          done;
          !w
  in
  match b.bbase with
  | B8 ->
      fun v buf off -> S.unsafe_set_uint8 buf (Off.at off delta :> int) (word v)
  | B16 Big_endian ->
      fun v buf off ->
        S.unsafe_set_uint16_be buf (Off.at off delta :> int) (word v)
  | B16 Little_endian ->
      fun v buf off ->
        S.unsafe_set_uint16_le buf (Off.at off delta :> int) (word v)
  | B16 Native_endian ->
      fun v buf off ->
        S.unsafe_set_uint16_ne buf (Off.at off delta :> int) (word v)
  | B32 Big_endian ->
      fun v buf off ->
        S.unsafe_set_int32_be buf
          (Off.at off delta :> int)
          (Int32.of_int (word v))
  | B32 Little_endian ->
      fun v buf off ->
        S.unsafe_set_int32_le buf
          (Off.at off delta :> int)
          (Int32.of_int (word v))
  | B32 Native_endian ->
      fun v buf off ->
        S.unsafe_set_int32_ne buf
          (Off.at off delta :> int)
          (Int32.of_int (word v))

let bits_writer : type a. a bits -> a swrite =
 fun b -> bits_writer_at Off.zero b

let rec static_writer_for : type a b. rel -> (a -> b) -> b t -> a swrite option
    =
 fun delta get t ->
  match t with
  | Primary p -> static_primary_writer_for delta get p
  | Map { x; g; _ } -> static_writer_for delta (fun v -> g (get v)) x
  | Record r ->
      begin match static_record_writer_at delta r with
      | Some wr -> Some (fun v buf off -> wr (get v) buf off)
      | None -> None
      end
  | Bits b ->
      let wr = bits_writer_at delta b in
      Some (fun v buf off -> wr (get v) buf off)
  | _ -> None

and static_primary_writer_for : type a b.
    rel -> (a -> b) -> b primary -> a swrite option =
 fun delta get t ->
  match t with
  | Const _ -> Some w_ignore3
  | Char -> Some (w_char delta get)
  | UInt8 -> Some (w_ui8 delta get)
  | Int8 -> Some (w_i8 delta get)
  | UInt16 Big_endian -> Some (w_ui16_be delta get)
  | UInt16 Little_endian -> Some (w_ui16_le delta get)
  | UInt16 Native_endian -> Some (w_ui16_ne delta get)
  | Int16 Big_endian -> Some (w_i16_be delta get)
  | Int16 Little_endian -> Some (w_i16_le delta get)
  | Int16 Native_endian -> Some (w_i16_ne delta get)
  | Int32 Big_endian -> Some (w_i32_be delta get)
  | Int32 Little_endian -> Some (w_i32_le delta get)
  | Int32 Native_endian -> Some (w_i32_ne delta get)
  | Int64 Big_endian -> Some (w_i64_be delta get)
  | Int64 Little_endian -> Some (w_i64_le delta get)
  | Int64 Native_endian -> Some (w_i64_ne delta get)
  | Var_int | Bytes _ | Until _ | Bstr _ -> None

(* NOTE(dinosaure): here, we compile an array which contains encoders for each
   field of the record. Compilation is only possible if the size of the record's
   serialisation is known statically. *)

and static_record_cells : type a. rel -> a record -> a swrite array option =
 fun delta r ->
  let exception Not_static in
  let delta = ref delta in
  try
    let fn (Bin_type.Field field) =
      let w =
        match static_writer_for !delta field.fget field.ftype with
        | Some w -> w
        | None -> raise_notrace Not_static
      in
      begin match (Bin_size.make field.ftype).Bin_size.layout with
      | Some n -> delta := Off.(!delta +> n)
      | None -> raise_notrace Not_static
      end;
      w
    in
    let cells = List.map fn (record_fields r) in
    Some (Array.of_list cells)
  with Not_static -> None

and static_record_writer_at : type a. rel -> a record -> a swrite option =
 fun delta r ->
  match static_record_cells delta r with
  | None -> None
  | Some cells ->
      let len = Array.length cells in
      let fn v buf off =
        for i = 0 to len - 1 do
          (Array.unsafe_get cells i) v buf off
        done
      in
      Some fn

and static_writer : type a. a t -> a swrite option =
 fun t -> static_writer_for Off.zero Fun.id t

(* NOTE(dinosaure): here is our closure compiler for generating our encoder.
   This isn't the _happy path_, but the most generic (and least optimal)
   approach. *)
let rec writer : type a. a t -> a -> S.t -> abs -> pos -> unit =
 fun root ->
  let memo : wmemo list ref = ref [] in
  let rec go : type a. a t -> a -> S.t -> abs -> pos -> unit =
   fun t ->
    match t with
    | Primary p -> prim p
    | Map { x; g; _ } ->
        let wr = go x in
        fun v buf limit pos -> wr (g v) buf limit pos
    | Record r -> go_record r
    | Variant v -> go_variant v
    | Seq s -> go_seq s
    | Bind { bx; bf; bg } ->
        let wr = go bx in
        fun v buf limit pos ->
          let a = bg v in
          wr a buf limit pos;
          writer (bf a) v buf limit pos
    | Bits b ->
        let wr = bits_writer b in
        let w =
          match b.bbase with
          | B8 -> Len.unsafe 1
          | B16 _ -> Len.unsafe 2
          | B32 _ -> Len.unsafe 4
        in
        fun v buf limit pos ->
          let offset = !pos in
          Bin_error.need_bytes ~limit ~offset ~need:w;
          (pos := Off.(offset +> w));
          wr v buf offset
    | Fix r ->
        begin match wmemo_find r.rwitn !memo with
        | Some fn -> fn
        | None ->
            let cell = ref (fun _ _ _ _ -> assert false) in
            let fn : a -> S.t -> abs -> pos -> unit =
             fun v buf limit pos -> !cell v buf limit pos
            in
            memo := Wm (r.rwitn, fn) :: !memo;
            cell := go (Lazy.force r.runroll);
            fn
        end
  and go_record : type a. a record -> a -> S.t -> abs -> pos -> unit =
   fun r ->
    let rname = if r.rname = "" then "record" else r.rname in
    match
      ((Bin_size.make (Record r)).layout, static_record_cells Off.zero r)
    with
    | Some n, Some cells ->
        let k = Array.length cells in
        fun v buf limit pos ->
          let offset = !pos in
          begin try
            Bin_error.need_bytes ~limit ~offset ~need:n;
            for i = 0 to k - 1 do
              (Array.unsafe_get cells i) v buf offset
            done
          with exn -> Bin_error.reraise_in rname exn
          end;
          pos := Off.(offset +> n)
    | _ -> begin
        let delta = ref Off.zero in
        let left = ref false in
        let cells =
          let fn (Bin_type.Field field) =
            if !left then begin
              let wr = field_encoder field in
              fun v buf _offset limit pos -> wr (field.fget v) buf limit pos
            end
            else
              let size = (Bin_size.make field.ftype).layout in
              let wr = static_writer_for !delta field.fget field.ftype in
              match (wr, size) with
              | Some wr, Some w ->
                  (delta := Off.(!delta +> w));
                  fun v buf offset _ _ -> wr v buf offset
              | _ ->
                  left := true;
                  let delta = !delta in
                  let wr = field_encoder field in
                  fun v buf offset limit pos ->
                    pos := Off.at offset delta;
                    wr (field.fget v) buf limit pos
          in
          List.map fn (record_fields r)
        in
        let cells = Array.of_list cells in
        let n = Array.length cells in
        let prefix = Off.from_base !delta in
        fun v buf limit pos ->
          let offset = !pos in
          try
            Bin_error.need_bytes ~limit ~offset ~need:prefix;
            for i = 0 to n - 1 do
              (Array.unsafe_get cells i) v buf offset limit pos
            done
          with exn -> Bin_error.reraise_in rname exn
      end
  and field_encoder : type a b. (a, b) field -> b -> S.t -> abs -> pos -> unit =
   fun field ->
    let wr = go field.ftype in
    let name = field.fname in
    fun v buf limit pos ->
      try wr v buf limit pos with exn -> Bin_error.reraise_in name exn
  and go_variant : type a. a variant -> a -> S.t -> abs -> pos -> unit =
   fun v ->
    let tag = go v.vtag in
    let vname = if v.vname = "" then "variant" else v.vname in
    let c0 c buf limit pos = tag c.ctag0 buf limit pos in
    let c1 : type b. (a, b) case1 -> b -> S.t -> abs -> pos -> unit =
     fun c ->
      let wr = go c.ctype1 in
      let name = c.cname1 in
      fun x buf limit pos ->
        tag c.ctag1 buf limit pos;
        try wr x buf limit pos with exn -> Bin_error.reraise_in name exn
    in
    let dispatch = fold_variant { Case_folder.c0; c1 } v in
    fun value buf limit pos ->
      try dispatch value buf limit pos
      with exn -> Bin_error.reraise_in vname exn
  and go_seq : type a b. (a, b) seq -> b -> S.t -> abs -> pos -> unit =
   fun { slen; selt; skind } ->
    let elt = go selt in
    let count : b -> int =
      match skind with Sarray -> Array.length | Slist -> List.length
    in
    let iter : (a -> unit) -> b -> unit =
      match skind with Sarray -> Array.iter | Slist -> List.iter
    in
    match slen with
    | Fixed n ->
        fun v buf limit pos ->
          let got = count v in
          if got <> n then
            Bin_error.length_mismatch ~offset:!pos ~expected:n ~got;
          iter (fun x -> elt x buf limit pos) v
    | Prefix t ->
        let wn = go t in
        fun v buf limit pos ->
          wn (count v) buf limit pos;
          iter (fun x -> elt x buf limit pos) v
    | Rest -> fun v buf limit pos -> iter (fun x -> elt x buf limit pos) v
    | Delim _ ->
        assert false (* NOTE(dinosaure): see [Bin.seq] and [Bin.list] *)
  and prim : type a. a primary -> a -> S.t -> abs -> pos -> unit =
   fun p ->
    match p with
    | Const _ -> w_ignore4
    | Char ->
        fun v buf limit pos ->
          let offset = !pos in
          Bin_error.need_bytes ~limit ~offset ~need:Len.one;
          (pos := Off.(offset +> Len.one));
          S.unsafe_set buf (offset :> int) v
    | UInt8 -> w_1 S.unsafe_set_uint8
    | Int8 -> w_1 S.unsafe_set_int8
    | UInt16 Big_endian -> w_2 S.unsafe_set_uint16_be
    | UInt16 Little_endian -> w_2 S.unsafe_set_uint16_le
    | UInt16 Native_endian -> w_2 S.unsafe_set_uint16_ne
    | Int16 Big_endian -> w_2 S.unsafe_set_int16_be
    | Int16 Little_endian -> w_2 S.unsafe_set_int16_le
    | Int16 Native_endian -> w_2 S.unsafe_set_int16_ne
    | Int32 Big_endian -> w_4 S.unsafe_set_int32_be
    | Int32 Little_endian -> w_4 S.unsafe_set_int32_le
    | Int32 Native_endian -> w_4 S.unsafe_set_int32_ne
    | Int64 Big_endian -> w_8 S.unsafe_set_int64_be
    | Int64 Little_endian -> w_8 S.unsafe_set_int64_le
    | Int64 Native_endian -> w_8 S.unsafe_set_int64_ne
    | Var_int -> write_varint
    | Until _ ->
        fun v buf limit pos ->
          let offset = !pos in
          let n = String.length v in
          Bin_error.need_bytes ~limit ~offset ~need:(Len.unsafe n);
          S.blit_from_string v ~src_off:0 buf ~dst_off:(offset :> int) ~len:n;
          pos := Off.(offset +> Len.unsafe n)
    | Bytes len ->
        let blit v buf ~off ~len =
          S.blit_from_string v ~src_off:0 buf ~dst_off:off ~len
        in
        let contains v chr = String.contains v chr in
        payload len String.length blit contains
    | Bstr len ->
        let blit v buf ~off ~len =
          S.blit_from_bstr v ~src_off:0 buf ~dst_off:off ~len
        in
        let contains v chr = Bstr.contains v chr in
        payload len Bstr.length blit contains
  and payload : type a.
         len
      -> (a -> int)
      -> (a -> S.t -> off:int -> len:int -> unit)
      -> (a -> char -> bool)
      -> a
      -> S.t
      -> abs
      -> pos
      -> unit =
   fun len length blit contains ->
    match len with
    | Fixed n ->
        fun v buf limit pos ->
          let got = length v in
          if got <> n then
            Bin_error.length_mismatch ~offset:!pos ~expected:n ~got;
          let offset = !pos in
          Bin_error.need_bytes ~limit ~offset ~need:(Len.unsafe n);
          blit v buf ~off:(offset :> int) ~len:n;
          pos := Off.(offset +> Len.unsafe n)
    | Prefix t ->
        let wr = go t in
        fun v buf limit pos ->
          let n = length v in
          wr n buf limit pos;
          let offset = !pos in
          Bin_error.need_bytes ~limit ~offset ~need:(Len.unsafe n);
          blit v buf ~off:(offset :> int) ~len:n;
          pos := Off.(offset +> Len.unsafe n)
    | Rest ->
        fun v buf limit pos ->
          let n = length v in
          let offset = !pos in
          Bin_error.need_bytes ~limit ~offset ~need:(Len.unsafe n);
          blit v buf ~off:(offset :> int) ~len:n;
          pos := Off.(offset +> Len.unsafe n)
    | Delim chr ->
        fun v buf limit pos ->
          if contains v chr then
            Bin_error.msgf
              "Bin.bytes: the payload contains its own delimited %C, encoding \
               it would not round-trip"
              chr;
          let n = length v in
          let offset = !pos in
          Bin_error.need_bytes ~limit ~offset ~need:Len.(unsafe n + one);
          blit v buf ~off:(offset :> int) ~len:n;
          S.unsafe_set buf (Off.(offset +> Len.unsafe n) :> int) chr;
          pos := Off.(offset +> Len.(unsafe n + one))
  in
  go root

let encode : type a. a t -> a -> S.t -> pos -> unit =
 fun t ->
  let generic () =
    let wr = writer t in
    fun v buf pos -> wr v buf (Off.v (S.length buf)) pos
  in
  match t with
  | Record r ->
      begin match
        ((Bin_size.make t).layout, static_record_cells Off.zero r)
      with
      | Some n, Some cells ->
          let k = Array.length cells in
          fun v buf pos ->
            let offset = !pos in
            let limit = Off.v (S.length buf) in
            if Off.(offset +> n > limit) then
              Bin_error.truncated ~offset ~need:n ~have:(have ~limit ~offset);
            for i = 0 to k - 1 do
              (Array.unsafe_get cells i) v buf offset
            done;
            pos := Off.(offset +> n)
      | _ -> generic ()
      end
  | _ -> generic ()
