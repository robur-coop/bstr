[@@@warning "-unused-rec-flag"]

include Bin_type

type abs = Off.abs Off.t
type rel = Off.rel Off.t

[@@@ocamlformat "-disable"]

(* XXX(dinosaure): It's rather ugly, but it's necessary for performance. We need
   to be able to generate a function that allows writing, and this function must
   not contain any pattern matching (particularly regarding endianness). We need
   to move the pattern matching out of the write operation (and find it, in
   particular, in the [static_primary_writer_for] function).

   The trick [let _ = (); fun _ ->] is important here to ensure that the
   function has an arity of 3 when it is specialised. *)

let w_char delta get = (); fun v buf off ->
  S.unsafe_set buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ui8 delta get = (); fun v buf off ->
  S.unsafe_set_uint8 buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i8 delta get = (); fun v buf off ->
  S.unsafe_set_int8 buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ui16_le delta get = (); fun v buf off ->
  S.unsafe_set_uint16_le buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ui16_be delta get = (); fun v buf off ->
  S.unsafe_set_uint16_be buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ui16_ne delta get = (); fun v buf off ->
  S.unsafe_set_uint16_ne buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i16_le delta get = (); fun v buf off ->
  S.unsafe_set_int16_le buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i16_be delta get = (); fun v buf off ->
  S.unsafe_set_int16_be buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i16_ne delta get = (); fun v buf off ->
  S.unsafe_set_int16_ne buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i32_le delta get = (); fun v buf off ->
  S.unsafe_set_int32_le buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i32_be delta get = (); fun v buf off ->
  S.unsafe_set_int32_be buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i32_ne delta get = (); fun v buf off ->
  S.unsafe_set_int32_ne buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i64_le delta get = (); fun v buf off ->
  S.unsafe_set_int64_le buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i64_be delta get = (); fun v buf off ->
  S.unsafe_set_int64_be buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_i64_ne delta get = (); fun v buf off ->
  S.unsafe_set_int64_ne buf (Off.at off delta :> int) (get v)
[@@inline always]

let w_ignore3 _ _ _ = ()

(* XXX(dinosaure): the same but for an arity of 4. *)

let w_ignore4 _ _ _ _ = ()

let[@inline always] w_1 set = (); fun v buf limit pos ->
  let offset = !pos in
  Bin_error.need_bytes ~limit ~offset ~need:Len.one;
  pos := Off.(offset +> Len.one);
  set buf (offset :> int) v

let[@inline always] w_2 set = ();
  fun v buf limit pos ->
  let _2 = Len.v 2 in
  let offset = !pos in
  Bin_error.need_bytes ~limit ~offset ~need:_2;
  pos := Off.(offset +> _2);
  set buf (offset :> int) v

let[@inline always] w_4 set = ();
  fun v buf limit pos ->
  let _4 = Len.v 4 in
  let offset = !pos in
  Bin_error.need_bytes ~limit ~offset ~need:_4;
  pos := Off.(offset +> _4);
  set buf (offset :> int) v

let[@inline always] w_8 set = ();
  fun v buf limit pos ->
  let _8 = Len.v 8 in
  let offset = !pos in
  Bin_error.need_bytes ~limit ~offset ~need:_8;
  pos := Off.(offset +> _8);
  set buf (offset :> int) v

(* Thanks, god! *)

[@@@ocamlformat "-enable"]

type 'a fwrite = 'a -> S.t -> int -> int -> pos -> unit
type 'a swrite = 'a -> S.t -> abs -> unit

let rec static_writer_for : type a b. rel -> (a -> b) -> b t -> a swrite option
    =
 fun delta get t ->
  match t with
  | Primary p -> static_primary_writer_for delta get p
  | Map { x; g; _ } -> static_writer_for delta (fun v -> g (get v)) x
  | Record r ->
      begin match static_record_writer_at delta r with
      | Some wr -> Some (fun v buf off -> wr (get v) buf off)
      | None -> None
      end
  | _ -> None

and static_primary_writer_for : type a b.
    rel -> (a -> b) -> b primary -> a swrite option =
 fun delta get t ->
  match t with
  | Const _ -> Some w_ignore3
  | Char -> Some (w_char delta get)
  | UInt8 -> Some (w_ui8 delta get)
  | Int8 -> Some (w_i8 delta get)
  | UInt16 Big_endian -> Some (w_ui16_be delta get)
  | UInt16 Little_endian -> Some (w_ui16_le delta get)
  | UInt16 Native_endian -> Some (w_ui16_ne delta get)
  | Int16 Big_endian -> Some (w_i16_be delta get)
  | Int16 Little_endian -> Some (w_i16_le delta get)
  | Int16 Native_endian -> Some (w_i16_ne delta get)
  | Int32 Big_endian -> Some (w_i32_be delta get)
  | Int32 Little_endian -> Some (w_i32_le delta get)
  | Int32 Native_endian -> Some (w_i32_ne delta get)
  | Int64 Big_endian -> Some (w_i64_be delta get)
  | Int64 Little_endian -> Some (w_i64_le delta get)
  | Int64 Native_endian -> Some (w_i64_ne delta get)
  | Var_int | Bytes _ | CString | Until _ | Bstr _ -> None

(* NOTE(dinosaure): here, we compile an array which contains encoders for each
   field of the record. Compilation is only possible if the size of the record's
   serialisation is known statically. *)

and static_record_cells : type a. rel -> a record -> a swrite array option =
 fun delta r ->
  let exception Not_static in
  let delta = ref delta in
  try
    let fn (Bin_type.Field field) =
      let w =
        match static_writer_for !delta field.fget field.ftype with
        | Some w -> w
        | None -> raise_notrace Not_static
      in
      begin match (Bin_size.make field.ftype).Bin_size.layout with
      | Some n -> delta := Off.(!delta +> n)
      | None -> raise_notrace Not_static
      end;
      w
    in
    let cells = List.map fn (record_fields r) in
    Some (Array.of_list cells)
  with Not_static -> None

and static_record_writer_at : type a. rel -> a record -> a swrite option =
 fun delta r ->
  match static_record_cells delta r with
  | None -> None
  | Some cells ->
      let len = Array.length cells in
      let fn v buf off =
        for i = 0 to len - 1 do
          (Array.unsafe_get cells i) v buf off
        done
      in
      Some fn

and static_writer : type a. a t -> a swrite option =
  fun t -> static_writer_for Off.zero Fun.id t

(* NOTE(dinosaure): here is our closure compiler for generating our encoder.
   This isn't the _happy path_, but the most generic (and least optimal)
   approach. *)
let rec writer : type a. a t -> a -> S.t -> abs -> pos -> unit =
 fun root ->
  let rec go : type a. a t -> a -> S.t -> abs -> pos -> unit =
   fun t ->
    match t with
    | Primary p -> prim p
    | Map { x; g; _ } ->
      let wr = go x in
      fun v buf limit pos -> wr (g v) buf limit pos
    | Record r -> go_record r
    | Variant v -> go_variant v
    | Seq _s -> assert false
  and go_record : type a. a record -> a -> S.t -> abs -> pos -> unit =
   fun r ->
    let rname = if r.rname = "" then "record" else r.rname in
    match (Bin_size.make (Record r)).layout, static_record_cells Off.zero r with
    | Some n, Some cells ->
      let k = Array.length cells in
      let fn v buf limit pos =
        let offset = !pos in
        begin try
          Bin_error.need_bytes ~limit ~offset ~need:n;
          for i = 0 to k - 1 do
            (Array.unsafe_get cells i) v buf offset;
          done
        with exn -> Bin_error.reraise_in rname exn end;
        pos := Off.(offset +> n) in
      fn
   | _ ->
      let delta = ref Off.zero in
      let left = ref false in
      let cells =
        let fn (Bin_type.Field field) =
          if !left then begin
            let wr = field_encoder field in
            fun v buf _offset limit pos -> wr (field.fget v) buf limit pos
          end else
            let size = (Bin_size.make field.ftype).layout in
            let wr = static_writer_for !delta field.fget field.ftype in
            match wr, size with
            | Some wr, Some w ->
              delta := Off.(!delta +> w);
              fun v buf offset _ _ -> wr v buf offset
            | _ ->
              left := true;
              let delta = !delta in
              let wr = field_encoder field in
              fun v buf offset limit pos ->
                pos := Off.at offset delta;
                wr (field.fget v) buf limit pos in
        List.map fn (record_fields r) in
      let cells = Array.of_list cells in
      let n = Array.length cells in
      let prefix = Off.from_base !delta in
      fun v buf limit pos ->
        let offset = !pos in
        try
          Bin_error.need_bytes ~limit ~offset ~need:prefix;
          for i = 0 to n - 1 do
            (Array.unsafe_get cells i) v buf offset limit pos
          done
       with exn -> Bin_error.reraise_in rname exn
  and field_encoder : type a b. (a, b) field -> b -> S.t -> abs -> pos -> unit
   = fun field ->
    let wr = go field.ftype in
    let name = field.fname in
    fun v buf limit pos ->
      try wr v buf limit pos with exn -> Bin_error.reraise_in name exn
  and go_variant : type a. a variant -> a -> S.t -> abs -> pos -> unit =
   fun v ->
    let tag = go v.vtag in
    let vname = if v.vname = "" then "variant" else v.vname in
    let c0 c buf limit pos = tag c.ctag0 buf limit pos in
    let c1 : type b. (a, b) case1 -> b -> S.t -> abs -> pos -> unit =
      fun c ->
        let wr = go c.ctype1 in
        let name = c.cname1 in
        fun x buf limit pos ->
          tag c.ctag1 buf limit pos;
          try wr x buf limit pos
          with exn -> Bin_error.reraise_in name exn in
      let dispatch = fold_variant { Case_folder.c0; c1 } v in
      fun value buf limit pos ->
        try dispatch value buf limit pos
        with exn ->
          Bin_error.reraise_in vname exn
  and prim : type a. a primary -> a -> S.t -> abs -> pos -> unit =
   fun p ->
    match p with
    | Const _ -> w_ignore4
    | Char ->
      fun v buf limit pos ->
        let offset = !pos in
        Bin_error.need_bytes ~limit ~offset ~need:Len.one;
        pos := Off.(offset +> Len.one);
        S.unsafe_set buf (offset :> int) v
    | UInt8 -> w_1 S.unsafe_set_uint8
    | Int8 -> w_1 S.unsafe_set_int8
    | UInt16 Big_endian -> w_2 S.unsafe_set_uint16_be
    | UInt16 Little_endian -> w_2 S.unsafe_set_uint16_le
    | UInt16 Native_endian -> w_2 S.unsafe_set_uint16_ne
    | Int16 Big_endian -> w_2 S.unsafe_set_int16_be
    | Int16 Little_endian -> w_2 S.unsafe_set_int16_le
    | Int16 Native_endian -> w_2 S.unsafe_set_int16_ne
    | Int32 Big_endian -> w_4 S.unsafe_set_int32_be
    | Int32 Little_endian -> w_4 S.unsafe_set_int32_le
    | Int32 Native_endian -> w_4 S.unsafe_set_int32_ne
    | Int64 Big_endian -> w_8 S.unsafe_set_int64_be
    | Int64 Little_endian -> w_8 S.unsafe_set_int64_le
    | Int64 Native_endian -> w_8 S.unsafe_set_int64_ne
    | Var_int -> assert false
    | Until _ -> assert false
    | Bytes _ -> assert false
    | Bstr _ -> assert false
    | CString -> assert false
  in
  go root

let encode : type a. a t -> a -> S.t -> pos -> unit =
  fun t ->
    let generic () =
      let wr = writer t in
      fun v buf pos -> wr v buf (Off.v (S.length buf)) pos
    in
    match t with
    | Record r ->
      begin match (Bin_size.make t).layout, static_record_cells Off.zero r with
      | Some n, Some cells ->
        let k = Array.length cells in
        let fn v buf pos =
          let offset = !pos in
          let limit = Off.v (S.length buf) in
          if Off.(offset +> n > limit)
          then Bin_error.truncated ~offset ~need:n ~have:(have ~limit ~offset);
          for i = 0 to k - 1 do
            (Array.unsafe_get cells i) v buf offset
          done;
          pos := Off.(offset +> n) in
        fn
      | _ -> generic () end
   | _ -> generic ()

(*
type 'a encoder = 'a -> S.t -> pos -> unit


let encode_bytes len src buf off =
  let pos = !off in
  off := !off + len;
  S.blit_string src 0 buf pos len

let encode_bstr len src buf off =
  let dst_off = !off in
  off := !off + len;
  Bstr.blit_to_bytes src ~src_off:0 buf ~dst_off ~len

let encode_varint value buf off =
  let num = ref (value lsr 7) in
  let cmd = ref (value land 0x7f) in
  cmd := if !num != 0 then !cmd lor 0x80 else !cmd;
  S.set_uint8 buf !off !cmd;
  incr off;
  while !num != 0 do
    cmd := !num land 0x7f;
    num := !num lsr 7;
    cmd := if !num != 0 then !cmd lor 0x80 else !cmd;
    S.set_uint8 buf !off !cmd;
    incr off
  done

let encode_cstring src buf off =
  let pos = !off in
  let len = String.length src in
  off := !off + len;
  S.blit_string src 0 buf pos len;
  S.set_uint8 buf !off 0;
  incr off

let encode_until src buf off =
  let pos = !off in
  let len = String.length src in
  off := !off + len;
  S.blit_string src 0 buf pos len

let rec encode : type a. a t -> a encoder = function
  | Primary p -> prim p
  | Map m -> map m
  | Record r -> record r
  | Variant v -> variant v
  | Seq s -> seq s

and seq : type a b. (a, b) seq -> b encoder = fun _ -> assert false

and prim : type a. a primary -> a encoder = function
  | Char -> encode_char
  | UInt8 -> encode_uint8
  | Int8 -> encode_int8
  | UInt16 e -> encode_uint16 e
  | Int16 e -> encode_int16 e
  | Int32 e -> encode_int32 e
  | Int64 e -> encode_int64 e
  | Bytes len -> encode_bytes len
  | Var_int -> encode_varint
  | CString -> encode_cstring
  | Until _ -> encode_until
  | Bstr _ -> assert false
  | Const _ -> fun _v _bstr _off -> ()

and record : type a. a record -> a encoder =
 fun r ->
  let fields_encoders : (a -> S.t -> pos -> unit) list =
    let fn (Field f) = fun v buf off -> (encode f.ftype) (f.fget v) buf off in
    List.map fn (fields r)
  in
  fun v buf off -> List.iter (fun fn -> fn v buf off) fields_encoders

and variant : type a. a variant -> a encoder =
  let c0 { ctag0; _ } = encode_varint ctag0 in
  let c1 c =
    let arg = encode c.ctype1 in
    fun v buf off ->
      encode_varint c.ctag1 buf off;
      arg v buf off
  in
  fun v -> fold_variant { c0; c1 } v

and map : type a b. (a, b) map -> b encoder =
 fun { x; g; _ } -> fun u buf off -> encode x (g u) buf off

*)
