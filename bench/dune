(executable
 (name sub)
 (enabled_if
  (= %{profile} benchmark))
 (libraries slice.bytes slice.bstr bstr cstruct bechamel bechamel-js))

(rule
 (targets sub.json)
 (enabled_if
  (= %{profile} benchmark))
 (action
  (with-stdout-to
   %{targets}
   (run ./sub.exe))))

(rule
 (targets sub.html)
 (enabled_if
  (= %{profile} benchmark))
 (action
  (system "%{bin:bechamel-html} < %{dep:sub.json} > %{targets}")))

